# ==========================================
# Configurações do Banco de Dados PostgreSQL
# ==========================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tuss_db
DB_PORT=5432

# ==========================================
# Portas da Aplicação (Desenvolvimento e Produção)
# ==========================================
BACKEND_PORT=3000
FRONTEND_PORT=5173
PROD_PORT=5173

# ==========================================
# Configurações do Backend (Execução local/nativa)
# ==========================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tuss_db
PORT=3000
NODE_ENV=development
